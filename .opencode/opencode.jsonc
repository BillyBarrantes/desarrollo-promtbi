{
  "default_agent": "planner",
  "permission": {
    "*": "ask",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "lsp": "allow",
    "edit": {
      "*": "ask",
      ".env": "deny",
      ".env.*": "deny"
    },
    "bash": {
      "*": "ask",
      "pytest*": "allow",
      "cd backend && pytest*": "allow",
      "npm run lint*": "allow",
      "pnpm lint*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git push*": "deny"
    },
    "skill": {
      "plan-*": "allow",
      "qa-*": "allow",
      "pr-*": "ask",
      "infra-*": "deny",
      "prod-*": "deny"
    },
    "external_directory": "deny"
  }
}
