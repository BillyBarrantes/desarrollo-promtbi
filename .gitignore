node_modules/
**/node_modules/
.next/
**/.next/
dist/
.env*
.venv/
**/.venv/

# Entorno de operaciones agénticas temporales (.ops)
.ops/logs/*
.ops/artifacts/*
.ops/locks/*
.ops/locks/*.lock
!.ops/logs/.gitkeep
!.ops/locks/.gitkeep
!.ops/artifacts/.gitkeep
!.ops/approvals/.gitkeep
!.ops/queue/.gitkeep

# Python caches and test artifacts
**/__pycache__/
*.py[cod]
.pytest_cache/
**/.pytest_cache/

# Playwright artifacts
frontend/playwright-report/
frontend/test-results/
